# Application
APP_ENV=development
APP_NAME=OpsMind
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Database — Supabase (Postgres + pgvector).
# 1. Supabase dashboard → Connect → "Session pooler" URI (port 5432). Do not use the
#    Transaction pooler (port 6543): live updates need LISTEN/NOTIFY and session settings.
# 2. Paste it below, then run:  python scripts/configure_supabase_env.py
#    That fills in the DATABASE_URL* values, a read-only role password and small
#    connection pools. It never prints your password.
SUPABASE_DB_URL=
DATABASE_URL=
DATABASE_URL_SYNC=
DATABASE_URL_READONLY=

# Read-only role for the investigation SQL tool (created by `python -m opsmind.db.seed`).
DB_READONLY_USER=opsmind_readonly
DB_READONLY_PASSWORD=

# Connections per API process — keep small; Supabase caps pooler client connections.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_READONLY_POOL_SIZE=3
DB_READONLY_POOL_MAX_OVERFLOW=3

# LLM providers — Groq (OpenAI-compatible). Never commit real keys.
# Models: https://console.groq.com/docs/models (use IDs your project key can access)
# Get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_STRONG=openai/gpt-oss-120b

# Embeddings — local hashing for tests/CI; OpenAI for production playbooks (MT3).
# Local keeps EMBEDDING_DIM=384. OpenAI text-embedding-3-small requests dimensions=384.
OPSMIND_EMBEDDING_PROVIDER=local
OPSMIND_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
PLAYBOOK_MAX_COUNT=25
PLAYBOOK_MAX_UPLOAD_MB=2

# MT4 — CSV business data plane (ZIP with products/orders/order_items)
CSV_MAX_UPLOAD_MB=10
CSV_MAX_ROWS=50000

# Investigation budgets (used from P4+)
MAX_CRITIC_RETRIES=2
MAX_TOOL_CALLS_PER_RUN=60
# Investigations started from the web console run in a background thread pool
# (progress is pushed to the browser over GET /events/stream).
INVESTIGATION_WORKERS=4

# P5 — API authentication (required for /investigations and /tools)
# Send as header: X-API-Key: <value>  OR  Authorization: Bearer <value>
# REQUIRED — no default is accepted. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OPSMIND_API_KEY=

# MT2 — JWT for web login/signup. REQUIRED — no default. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=72
AUTH_INVITE_DEFAULT_MAX_USES=10
AUTH_INVITE_DEFAULT_TTL_DAYS=14
AUTH_MAX_ACTIVE_INVITES=25
# Password reset (email link). Without SMTP_HOST, reset links are logged by the API (dev).
AUTH_PASSWORD_RESET_TTL_MINUTES=60
AUTH_PASSWORD_RESET_MAX_PER_HOUR=5
APP_PUBLIC_URL=http://localhost:3000
# CORS allowlist — comma-separated origins allowed to call the API with credentials.
# Defaults to APP_PUBLIC_URL when unset. Never use "*".
CORS_ALLOWED_ORIGINS=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=OpsMind <noreply@opsmind.local>
# Frontend (apps/web) — Vite reads VITE_* from apps/web/.env or the shell, not this file.
# Leave VITE_API_BASE_URL unset for `npm run dev` (Vite proxies API paths to localhost:8000)
# or when the built app is served from the same origin as the API. For split hosting:
#   VITE_API_BASE_URL=https://api.yourdomain.com

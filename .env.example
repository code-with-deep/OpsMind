# Application
APP_ENV=development
APP_NAME=OpsMind
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_USER=opsmind
POSTGRES_PASSWORD=opsmind
POSTGRES_DB=opsmind
POSTGRES_PORT=5432

# Local / host machine connections (API outside Docker)
DATABASE_URL=postgresql+asyncpg://opsmind:opsmind@localhost:5432/opsmind
DATABASE_URL_SYNC=postgresql://opsmind:opsmind@localhost:5432/opsmind
DATABASE_URL_READONLY=postgresql+asyncpg://opsmind_readonly:opsmind_readonly@localhost:5432/opsmind

# Docker Compose connections (API container → db service hostname)
DATABASE_URL_DOCKER=postgresql+asyncpg://opsmind:opsmind@db:5432/opsmind
DATABASE_URL_SYNC_DOCKER=postgresql://opsmind:opsmind@db:5432/opsmind
DATABASE_URL_READONLY_DOCKER=postgresql+asyncpg://opsmind_readonly:opsmind_readonly@db:5432/opsmind

# Read-only role (created by seed; used by investigation tools from P2+)
DB_READONLY_USER=opsmind_readonly
DB_READONLY_PASSWORD=opsmind_readonly

# LLM providers — Groq (OpenAI-compatible). Never commit real keys.
# Get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_MODEL_STRONG=llama-3.3-70b-versatile

# Embeddings: P2 uses local hashing (384-d). Groq chat is for agents (P3+).
# OPSMIND_EMBEDDING_PROVIDER=local

# Investigation budgets (used from P4+)
MAX_CRITIC_RETRIES=2
MAX_TOOL_CALLS_PER_RUN=40

# P5 — API authentication (required for /investigations and /tools)
# Send as header: X-API-Key: <value>  OR  Authorization: Bearer <value>
OPSMIND_API_KEY=change-me-opsmind-dev-key

# Frontend — API base URL (optional)
# Leave empty for same-origin requests via Vite dev proxy or a production reverse proxy.
# Set for split deployments, e.g. VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=

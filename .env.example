# Application
APP_ENV=development
APP_NAME=OpsMind
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_USER=opsmind
POSTGRES_PASSWORD=opsmind
POSTGRES_DB=opsmind
POSTGRES_PORT=5432

# Local / host machine connections (API outside Docker)
DATABASE_URL=postgresql+asyncpg://opsmind:opsmind@localhost:5432/opsmind
DATABASE_URL_SYNC=postgresql://opsmind:opsmind@localhost:5432/opsmind
DATABASE_URL_READONLY=postgresql+asyncpg://opsmind_readonly:opsmind_readonly@localhost:5432/opsmind

# Docker Compose connections (API container → db service hostname)
DATABASE_URL_DOCKER=postgresql+asyncpg://opsmind:opsmind@db:5432/opsmind
DATABASE_URL_SYNC_DOCKER=postgresql://opsmind:opsmind@db:5432/opsmind
DATABASE_URL_READONLY_DOCKER=postgresql+asyncpg://opsmind_readonly:opsmind_readonly@db:5432/opsmind

# Read-only role (created by seed; used by investigation tools from P2+)
DB_READONLY_USER=opsmind_readonly
DB_READONLY_PASSWORD=opsmind_readonly

# LLM providers — Groq (OpenAI-compatible). Never commit real keys.
# Models: https://console.groq.com/docs/models (use IDs your project key can access)
# Get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_MODEL_STRONG=openai/gpt-oss-120b

# Embeddings — local hashing for tests/CI; OpenAI for production playbooks (MT3).
# Local keeps EMBEDDING_DIM=384. OpenAI text-embedding-3-small requests dimensions=384.
OPSMIND_EMBEDDING_PROVIDER=local
OPSMIND_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
PLAYBOOK_MAX_COUNT=25
PLAYBOOK_MAX_UPLOAD_MB=2

# MT4 — CSV business data plane (ZIP with products/orders/order_items)
CSV_MAX_UPLOAD_MB=10
CSV_MAX_ROWS=50000

# Investigation budgets (used from P4+)
MAX_CRITIC_RETRIES=2
MAX_TOOL_CALLS_PER_RUN=60

# P5 — API authentication (required for /investigations and /tools)
# Send as header: X-API-Key: <value>  OR  Authorization: Bearer <value>
# Default bootstrap key is hashed into demo tenant api_keys during MT1 migration.
OPSMIND_API_KEY=change-me-opsmind-dev-key

# MT2 — JWT for web login/signup (use a long random string in real deploys)
JWT_SECRET=change-me-opsmind-jwt-secret-dev-only
JWT_EXPIRE_HOURS=72
AUTH_INVITE_DEFAULT_MAX_USES=10
AUTH_INVITE_DEFAULT_TTL_DAYS=14
AUTH_MAX_ACTIVE_INVITES=25
# MT6 — encrypt warehouse DSNs (Fernet key). Optional: derived from JWT_SECRET if unset.
OPSMIND_SECRETS_KEY=

# Frontend — API base URL baked into the web build at image build time.
# Leave empty for production Docker (nginx same-origin proxy to the api service).
# Only set for split deployments, e.g. VITE_API_BASE_URL=https://api.yourdomain.com
# Never set this to http://localhost:... on a remote server — browsers would call
# the visitor's machine, not your server (Failed to fetch).
VITE_API_BASE_URL=
